# .env.example — copy this to .env and fill in your values
# Never commit .env to version control

#  Django core
# Generate a real one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to 0 in production
DEBUG=1

# POS ingest API key 
# Shared secret configured on each POS terminal. Change before deploying.
POS_API_KEY=dev-pos-key

# Timezone 
# Defines what "today" means for daily sales aggregation.
# Use a tz database name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=UTC

# Database (leave blank to use SQLite) 
# Uncomment and fill in to switch to Postgres. All four vars required.
# POSTGRES_DB=ops_dashboard
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_HOST=localhost
